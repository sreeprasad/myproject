# ---- Modal secret "showme" (hosted backend), or exported env vars when running the backend locally ----
SHOWME_API_TOKEN=            # any long random string: openssl rand -hex 16
CLOUDFLARE_ACCOUNT_ID=       # milestone 3+
CLOUDFLARE_API_TOKEN=        # milestone 3+
GEMINI_API_KEY=              # milestone 4+
ANTHROPIC_API_KEY=           # optional fallback
TYPESAFE_API_KEY=            # optional (stretch S2: Jev)
DECISION_PROVIDER=clef       # clef | clef-flash | jev
PRACTICE_PROVIDER=clef-flash # clef | clef-flash | jev

# ---- Vercel project env vars (demo-app) ----
# NEXT_PUBLIC_SHOWME_BACKEND=https://<your-workspace>--showme-api.modal.run
# NEXT_PUBLIC_SHOWME_TOKEN=<same value as SHOWME_API_TOKEN>
